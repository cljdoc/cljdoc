{:min-bb-version "1.13.222"
 :paths ["." "script"]
 :deps {lread/status-line {:git/url "https://github.com/lread/status-line.git"
                           :sha "eace48e2e0fcc65a3986d696fb0b910fa5790a1c"}
        dev.weavejester/cljfmt {:mvn/version "0.16.5"}
        etaoin/etaoin {:mvn/version "1.1.43"}
        io.github.borkdude/unused-deps {:git/sha "c6673b5549d02fa131d21b61695e283b18124b59"}
        org.clj-commons/pretty {:mvn/version "3.9.0"}
        org.babashka/esbuild {:mvn/version "0.1.1"}
        ;; reference as a git dep so that esbuild can easily find squint assets
        ;; using git/sha without git/tag to get some unreleased fixes
        io.github.squint-cljs/squint {:git/sha "639177e6a006d333aee9ede8b4b148c1ae802f1f"}}
 :pods {org.babashka/fswatcher {:version "0.0.7"}}
 :tasks
 {;; setup
  :requires ([babashka.fs :as fs]
             [clojure.string :as str]
             [lread.status-line :as status]
             ;; task code that we call directly
             [version]
             [compile-js]
             [compile-java]
             [package])
  :init (defn clj [args]
         (apply clojure args *command-line-args*))
  :cli helper.cli/base-opts

  ;; commands
  ;; Note: We don't use `:depends` for dependent tasks
  ;;       bb cli tasks always inherit options from their :depends, which we are not
  ;;       interested in, we instead simply invoke dependent task code directly.
  clean                {:exec-fn clean/task                   :doc "Delete all build work"}
  download-deps        {:exec-fn download-deps/task           :doc "Download clojure deps"}
  dev                  {:exec-fn dev-repl/task                :doc "Fire up a REPL for dev"}
  deps-js              {:exec-fn deps-js/task                 :doc "Bring down JS deps"}
  compile-js           {:exec-fn compile-js/task              :doc "Compile front end sources"}
  test-js              {:exec-fn compile-js/task              :doc "Run front-end tests"
                        :exec-args {:test true}}
  compile-java         {:exec-fn compile-java/task            :doc "Compile java sources"}
  server               {:task (do
                               (compile-js/task {})
                               (compile-java/task {})
                               (status/line :head "Launching server")
                               (clj "-M:cli run"))            :doc "Launch cljdoc server"}
  ingest               {:task (do
                               (compile-js/task {})
                               (compile-java/task {})
                               (status/line :head "Ingesting docs")
                               (clj "-M:cli ingest"))         :doc "Ingest docs locally for testing"}
  offline-docset       {:task (do
                               (compile-js/task {})
                               (compile-java/task {})
                               (status/line :head "Offline docset")
                               (clj "-M:cli offline-docset")) :doc "Create offline docset for built lib"}
  test                 {:task (do
                               (compile-js/task {})
                               (compile-java/task {})
                               (status/line :head "Running tests")
                               (clj "-M:test"))               :doc "Run tests"}
  lint                 {:exec-fn lint/task                    :doc "Lint source code using clj-kondo"}
  eastwood             {:task (do
                               (compile-java/task {})
                               (status/line :head "Running eastwood")
                               (clj "-M:test:eastwood"))      :doc "Lint source code using eastwood"}
  code-format          {:cmd {"check" {:exec-fn code-format/check}
                              "fix"   {:exec-fn code-format/fix}}
                        :exec-fn code-format/check
                        :doc "check or fix whitespace formatting"}
  current-version      {:exec-fn version/task               :doc "Print current version"}
  package              {:exec-fn package/task               :doc "Zip up cljdoc for docker"}
  docker-image         {:doc "Create docker image"
                        :task (do
                               (package/task {})
                               (status/line :head "Creating docker image")
                               (shell {:dir "ops/docker"}
                                "bb image.clj" (fs/absolutize "target/build/cljdoc.zip") (version/version)))}
  update-github-emojis {:exec-fn update-github-emojis/task  :doc "Update the github emojis used in cljdoc article markdown"}
  outdated             {:exec-fn outdated/task              :doc "report on outdated Clojure and JavaScript dependencies"}
  doc-update-readme    {:exec-fn doc-update-readme/task     :doc "Honour our contributors in README" }
  check-contributors   {:exec-fn check-contributors/task    :doc "Who'd we miss?"}
  unused-deps          {:exec-fn unused-deps/task           :doc "Find unused dependencies"}
  nvd-scan             {:exec-fn nvd-scan/task              :doc "Scan Clojure deps for vulnerabilities"}
  deploy
  {:doc "ops: Deploy to Production (run by CircleCI)"
   :task (let [cljdoc-version (version/version)]
           (status/line :head "Deploying cljdoc version %s" cljdoc-version)
           (apply shell {:dir "ops/exoscale/deploy"}
                  "clojure -M -m cljdoc.deploy deploy -t" cljdoc-version
                  *command-line-args*))}}}
